;; kanata.kbd

;; 1. Configuration settings
(defcfg
  ;; Pass through keys not explicitly mapped
  process-unmapped-keys yes 
)

;; 2. Source Keys (The physical keys we are modifying)
(defsrc
  caps  rctrl  lbrc  h  j  k  l
)

;; 3. Aliases (Your custom variables)
(defalias
  ;; Holds RCtrl AND activates 'nav-layer' simultaneously.
  ctl_nav (multi rctrl (layer-toggle nav-layer))

  ;; Attempt to use 'unmod' with a list argument to strip RCtrl
  left_n  (unmod (rctrl) left)
  down_n  (unmod (rctrl) down)
  up_n    (unmod (rctrl) up)
  right_n (unmod (rctrl) right)
  esc_n   (unmod (rctrl) esc)
)

;; 4. Base Layer (The default state of your keyboard)
(deflayer base
  @ctl_nav  @ctl_nav  lbrc  h  j  k  l
)

;; 5. Navigation Layer (Activated when RCtrl is held)
(deflayer nav-layer
  ;; The physical Caps and RCtrl are transparent
  _  _    
  
  ;; Physical [ (lbrc) now sends Escape (Ctrl stripped)
  @esc_n
  
  ;; hjkl to arrow keys (Ctrl stripped)
  @left_n  @down_n  @up_n  @right_n
)
