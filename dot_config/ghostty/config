theme = Aura

font-size = 15
font-family = JetBrainsMono NFM Bold
background-opacity = 0.8
background-blur = true
mouse-hide-while-typing = true
quick-terminal-screen = macos-menu-bar
macos-titlebar-style = hidden
window-padding-balance = true
shell-integration-features = no-cursor, sudo, no-title
cursor-style = block
window-padding-x = 0
quit-after-last-window-closed = true
quick-terminal-position = bottom
copy-on-select = clipboard
macos-option-as-alt = true
maximize = true
window-save-state = always
auto-update = off
scrollbar=never

# Keybindings
keybind = cmd+s>t=toggle_quick_terminal
keybind = cmd+s>r=reload_config

#colors
background = #1b0729

#shader
#custom-shader = shaders/manga_slash.glsl
#custom-shader = shaders/cursor_blaze_tapered.glsl
#custom-shader = shaders/cursor_smear.glsl
