{
  "mcpServers": {
    "context7": {
      "args": ["-y", "@upstash/context7-mcp"],
      "command": "npx"
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest",
        "--config",
        "/Users/beowulf/.config/playwright/config.json"
      ],
      "command": "npx"
    },
    "sequentialthinking": {
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "command": "npx"
    },
    "serena": {
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "command": "uvx",
      "disabled": false
    },
    "shopify-mcp": {
      "args": ["-y", "@shopify/dev-mcp@latest"],
      "command": "npx"
    }
  }
}
