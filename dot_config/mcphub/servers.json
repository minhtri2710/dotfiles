{
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "command": "npx"
    },
    "markitdown": {
      "command": "markitdown-mcp"
    },
    "mcp-obsidian": {
      "args": [
        "-y",
        "mcp-obsidian",
        "/Users/beowulf/Documents/obsidian"
      ],
      "command": "npx"
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx"
    },
    "prisma": {
      "args": [
        "-y",
        "prisma",
        "mcp"
      ],
      "command": "npx"
    },
    "sequentialthinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    },
    "serena": {
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "command": "uvx",
      "disabled": false
    },
    "taskwarrior": {
      "args": [
        "-y",
        "mcp-server-taskwarrior"
      ],
      "command": "npx"
    }
  }
}
