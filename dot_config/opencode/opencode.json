{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "autoupdate": true,
  "mcp": {
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.exa.ai/mcp"]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"]
    },
    "shopify-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@shopify/dev-mcp@latest"]
    },
    "knowledge-graph": {
      "type": "remote",
      "url": "http://127.0.0.1:27495/mcp/sse"
    },
    "prisma": {
      "type": "local",
      "command": ["npx", "-y", "prisma", "mcp"]
    }
  },
  "lsp": {
    "php": {
      "command": [
        "/Users/beowulf/.local/share/nvim/mason/packages/intelephense/node_modules/.bin/intelephense",
        "--stdio"
      ],
      "extensions": [".php"]
    }
  }
}
