{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "autoupdate": true,
  "agent": {
    "review": {
      "description": "Reviews code for best practices and potential issues"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena-mcp-server",
        "--context",
        "ide-assistant"
      ]
    },
    "mcp-obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-obsidian",
        "/Users/beowulf/Documents/obsidian"
      ]
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    },
    "prisma": {
      "type": "local",
      "command": ["npx", "-y", "prisma", "mcp"]
    },
    "markitdown": {
      "type": "local",
      "command": ["markitdown-mcp"],
      "enabled": true
    }
  }
}
