{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "docs/guidelines.md",
    ".cursor/rules/*.md"
  ],
  "keybinds": {
    "command_list": "ctrl+shift+p",
    "messages_half_page_down": "alt+f",
    "messages_half_page_up": "alt+b"
  },
  "mcp": {
    "beads": {
      "command": ["beads-mcp"],
      "enabled": true,
      "type": "local"
    },
    "chrome-devtools": {
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false,
      "type": "local"
    },
    "gkg": {
      "type": "remote",
      "url": "http://127.0.0.1:27495/mcp/sse"
    },
    "zai-mcp-server": {
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      },
      "type": "local"
    }
  },
  "model": "zai-coding-plan/glm-4.6",
  "small_model": "github-copilot/oswe-vscode-prime",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "webfetch": "allow"
  },
  "theme": "aura",
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    },
    "scroll_speed": 3
  },
  "plugin": ["opencode-gemini-auth", "@tarquinen/opencode-dcp"],
  "agent": {
    // ═══════════════════════════════════════════════════════════════════════
    // READ-ONLY AGENTS (Safe, cannot modify files)
    // ═══════════════════════════════════════════════════════════════════════
    // PLAN: Strategic planning mode
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    // EXPLORER: Fast file discovery
    "explorer": {
      "description": "Fast codebase exploration and file discovery",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-4.6",
      "temperature": 0.2,
      "maxSteps": 10,
      "tools": {
        "write": false,
        "edit": false
      }
    },
    // ANALYZER: Deep code understanding
    "analyzer": {
      "description": "Deep implementation analysis and pattern understanding",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-4.6",
      "temperature": 0.2,
      "maxSteps": 15,
      "tools": {
        "write": false,
        "edit": false
      }
    },
    // RESEARCHER: External documentation
    "researcher": {
      "description": "Fetch and analyze external documentation",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-4.6",
      "temperature": 0.2,
      "maxSteps": 10,
      "tools": {
        "write": false,
        "edit": false
      }
    },
    // REVIEWER: Code review
    "reviewer": {
      "description": "Code review with bug-first priority",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-4.6",
      "temperature": 0.2,
      "maxSteps": 10,
      "tools": {
        "write": false,
        "edit": false
      }
    },
    // ═══════════════════════════════════════════════════════════════════════
    // WRITE AGENTS (Can modify files)
    // ═══════════════════════════════════════════════════════════════════════
    // SMART: Multi-file orchestrator (from original)
    "smart": {
      "description": "Orchestrator for complex multi-file tasks",
      "mode": "primary",
      "temperature": 0.3,
      "maxSteps": 100
    },
    // IMPLEMENTER: Focused code writing
    "implementer": {
      "description": "Focused single-file code implementation",
      "mode": "subagent",
      "model": "proxypal/gemini-claude-opus-4-5-thinking",
      "temperature": 0.1,
      "maxSteps": 20
    },
    // DEBUGGER: Root cause analysis
    "debugger": {
      "description": "Systematic debugging and root cause analysis",
      "mode": "subagent",
      "model": "google/gemini-3-pro-preview",
      "temperature": 0.3,
      "maxSteps": 25
    },
    // TESTER: Write and run tests
    "tester": {
      "description": "Write tests in TDD or verification mode",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.2,
      "maxSteps": 20
    },
    // DOCUMENTER: Documentation writing
    "documenter": {
      "description": "Write and update documentation",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-4.6",
      "temperature": 0.2,
      "maxSteps": 15
    },
    // REFACTOR: Safe code restructuring
    "refactor": {
      "description": "Safe code refactoring preserving behavior",
      "mode": "subagent",
      "model": "proxypal/gemini-claude-sonnet-4-5-thinking",
      "temperature": 0.1,
      "maxSteps": 20
    }
  },
  "provider": {
