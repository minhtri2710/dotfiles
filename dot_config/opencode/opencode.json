{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    ".cursor/rules/*.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "model": "github-copilot/oswe-vscode-prime",
  "small_model": "github-copilot/oswe-vscode-prime",
  "theme": "aura",
  "keybinds": {
    "messages_half_page_up": "alt+b",
    "messages_half_page_down": "alt+f",
    "command_list": "ctrl+shift+p"
  },
  "mcp": {
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.exa.ai/mcp"]
    },
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "gkg": {
      "type": "remote",
      "url": "http://127.0.0.1:27495/mcp/sse"
    },
    "backlog": {
      "enabled": false,
      "type": "local",
      "command": ["backlog", "mcp", "start"]
    },
    "beads": {
      "enabled": false,
      "type": "local",
      "command": ["beads-mcp"]
    }
  },
  "plugin": ["opencode-skills", "opencode-sessions", "opencode-gemini-auth"],
  "provider": {
    "github-copilot": {
      "api": "https://api.individual.githubcopilot.com",
      "models": {
        "gpt-5.1-codex": {
          "provider": {
            "npm": "@ai-sdk/openai"
          }
        }
      }
    }
  }
}
